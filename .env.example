# =============================================================================
# JAC Motors — environment variables
# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
# Variables prefixed NEXT_PUBLIC_ are shipped to the browser — never put secrets there.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New-style publishable key (sb_publishable_…) — or use the legacy anon key below
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses RLS. Never expose to the client.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Business contact (CONFIRM with JAC Motors before launch) ----------------
NEXT_PUBLIC_MAIN_PHONE=+63283613333
NEXT_PUBLIC_MAIN_PHONE_DISPLAY=(02) 8361-3333
NEXT_PUBLIC_BREAKDOWN_PHONE=+63283613333
NEXT_PUBLIC_BREAKDOWN_PHONE_DISPLAY=(02) 8361-3333
# Viber requires a mobile number in international format
NEXT_PUBLIC_VIBER_NUMBER=+639081111999
NEXT_PUBLIC_MESSENGER_HANDLE=jacmotorsph
NEXT_PUBLIC_CONTACT_EMAIL=sales@jacmotors.ph

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="JAC Motors <no-reply@jacmotors.ph>"
# Comma-separated staff inboxes that receive new quote/booking alerts
STAFF_NOTIFY_EMAILS=sales@jacmotors.ph,service@jacmotors.ph
# Optional per-team overrides (fall back to STAFF_NOTIFY_EMAILS)
STAFF_NOTIFY_SALES=
STAFF_NOTIFY_PARTS=
STAFF_NOTIFY_SERVICE=

# --- Supabase Database Webhooks → /api/webhooks/supabase -------------------
# Sent by Supabase as header x-webhook-secret; drives booking/job status emails + SMS
SUPABASE_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- SMS (optional, Twilio) ----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Python service (FastAPI) — step 7 --------------------------------------
PYTHON_SERVICE_URL=http://localhost:8000
# Shared secret sent as X-Service-Secret header; must match the service's SERVICE_SHARED_SECRET
PYTHON_SERVICE_SECRET=change-me-to-a-long-random-string

# --- Revalidation ------------------------------------------------------------
# Used by admin publish actions / Supabase webhooks to trigger on-demand ISR
REVALIDATE_SECRET=change-me
