# --- Supabase (service role: server-side only, bypasses RLS) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# --- Shared secret: must equal PYTHON_SERVICE_SECRET in the Next.js app ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_SHARED_SECRET=

# --- Email (maintenance reminders) ---
RESEND_API_KEY=
EMAIL_FROM=JAC Motors <service@jacmotors.ph>
SITE_URL=https://jacmotors.ph

# --- Scheduler ---
# Run on exactly ONE instance. Alternatively leave off and hit
# POST /jobs/maintenance-reminders from a cron (Railway cron / Render cron job).
ENABLE_SCHEDULER=1
TIMEZONE=Asia/Manila
REMINDER_HOUR=8
REMINDER_COOLDOWN_DAYS=14

# Optional, comma-separated (only needed if a browser ever calls the service directly — it shouldn't)
ALLOWED_ORIGINS=
